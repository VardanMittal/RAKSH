<?xml version="1.0"?>
<robot name="ugv" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===== PARAMETERS ===== -->
  <xacro:property name="base_length"  value="0.50"/>
  <xacro:property name="base_width"   value="0.35"/>
  <xacro:property name="base_height"  value="0.10"/>
  <xacro:property name="wheel_radius" value="0.05"/>
  <xacro:property name="wheel_width"  value="0.04"/>
  <xacro:property name="wheel_sep"    value="0.40"/>
  <xacro:property name="PI"           value="3.14159265"/>

  <!-- ===== BASE LINK ===== -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="grey">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="5.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0507" ixy="0.0" ixz="0.0"
               iyy="0.0854" iyz="0.0"
               izz="0.1218"/>
    </inertial>
  </link>

  <!-- ===== WHEEL MACRO ===== -->
  <xacro:macro name="wheel" params="name x_pos y_pos">

    <link name="${name}_wheel">
      <visual>
        <geometry>
          <cylinder length="${wheel_width}" radius="${wheel_radius}"/>
        </geometry>
        <material name="black">
          <color rgba="0.1 0.1 0.1 1"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <cylinder length="${wheel_width}" radius="${wheel_radius}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.5"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.000260" ixy="0.0" ixz="0.0"
                 iyy="0.000260" iyz="0.0"
                 izz="0.000313"/>
      </inertial>
    </link>

    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child  link="${name}_wheel"/>
      <origin xyz="${x_pos} ${y_pos} 0" rpy="${-PI/2} 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>

  </xacro:macro>

  <!-- Instantiate 4 wheels -->
  <xacro:wheel name="fl" x_pos=" 0.15" y_pos=" ${wheel_sep/2}"/>
  <xacro:wheel name="fr" x_pos=" 0.15" y_pos="-${wheel_sep/2}"/>
  <xacro:wheel name="rl" x_pos="-0.15" y_pos=" ${wheel_sep/2}"/>
  <xacro:wheel name="rr" x_pos="-0.15" y_pos="-${wheel_sep/2}"/>

  <!-- ===== IMU ===== -->
  <link name="imu_link">
    <visual>
      <geometry><box size="0.02 0.02 0.01"/></geometry>
      <material name="red"><color rgba="1 0 0 1"/></material>
    </visual>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.000001" ixy="0" ixz="0"
               iyy="0.000001" iyz="0"
               izz="0.000001"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="imu_link"/>
    <origin xyz="0.0 0.0 0.05" rpy="0 0 0"/>
  </joint>

  <!-- ===== STEREO CAMERA MOUNT ===== -->
  <link name="camera_link">
    <visual>
      <geometry><box size="0.05 0.15 0.04"/></geometry>
      <material name="blue"><color rgba="0.0 0.0 1.0 1"/></material>
    </visual>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0"
               iyy="0.0001" iyz="0"
               izz="0.0001"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="camera_link"/>
    <origin xyz="0.25 0.0 0.05" rpy="0 0 0"/>
  </joint>

  <!-- Left camera optical frame -->
  <link name="camera_left_link"/>
  <joint name="camera_left_joint" type="fixed">
    <parent link="camera_link"/>
    <child  link="camera_left_link"/>
    <origin xyz="0 0.06 0" rpy="${-PI/2} 0 ${-PI/2}"/>
  </joint>

  <!-- Right camera optical frame -->
  <link name="camera_right_link"/>
  <joint name="camera_right_joint" type="fixed">
    <parent link="camera_link"/>
    <child  link="camera_right_link"/>
    <origin xyz="0 -0.06 0" rpy="${-PI/2} 0 ${-PI/2}"/>
  </joint>

  <!-- ===== GAZEBO MATERIAL COLORS ===== -->
  <gazebo reference="base_link">
    <material>Gazebo/Grey</material>
  </gazebo>
  <gazebo reference="fl_wheel"><material>Gazebo/Black</material></gazebo>
  <gazebo reference="fr_wheel"><material>Gazebo/Black</material></gazebo>
  <gazebo reference="rl_wheel"><material>Gazebo/Black</material></gazebo>
  <gazebo reference="rr_wheel"><material>Gazebo/Black</material></gazebo>

  <!-- ===== GZ SIM PLUGINS (Harmonic) ===== -->

  <!-- Differential drive controller -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system"
            name="gz::sim::systems::DiffDrive">
      <left_joint>fl_wheel_joint</left_joint>
      <left_joint>rl_wheel_joint</left_joint>
      <right_joint>fr_wheel_joint</right_joint>
      <right_joint>rr_wheel_joint</right_joint>
      <wheel_separation>${wheel_sep}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <odom_publish_frequency>30</odom_publish_frequency>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
    </plugin>
  </gazebo>

  <!-- Joint state publisher -->
  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
    </plugin>
  </gazebo>

  <!-- IMU sensor -->
  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <topic>imu/data</topic>
      <gz_frame_id>imu_link</gz_frame_id>
    </sensor>
  </gazebo>

  <!-- Left camera -->
  <gazebo reference="camera_left_link">
    <sensor name="camera_left" type="camera">
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <topic>camera/left/image_raw</topic>
      <gz_frame_id>camera_left_link</gz_frame_id>
      <camera>
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>RGB_INT8</format>
        </image>
        <clip><near>0.02</near><far>30.0</far></clip>
      </camera>
    </sensor>
  </gazebo>

  <!-- Right camera -->
  <gazebo reference="camera_right_link">
    <sensor name="camera_right" type="camera">
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <topic>camera/right/image_raw</topic>
      <gz_frame_id>camera_right_link</gz_frame_id>
      <camera>
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>RGB_INT8</format>
        </image>
        <clip><near>0.02</near><far>30.0</far></clip>
      </camera>
    </sensor>
  </gazebo>

</robot>