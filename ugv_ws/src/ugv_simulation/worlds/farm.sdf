<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="farm">

    <!-- Physics -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Required Gazebo Harmonic plugins -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-contact-system"
            name="gz::sim::systems::Contact"/>

    <!-- Lighting -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>50 50</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>50 50</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.3 0.5 0.2 1</ambient>
            <diffuse>0.3 0.5 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ===== PLANT ROW 1 (healthy - green) ===== -->
    <model name="plant_1_1">
      <static>true</static>
      <pose>3.0 0.0 0 0 0 0</pose>
      <link name="link">
        <visual name="stem">
          <pose>0 0 0.3 0 0 0</pose>
          <geometry><box><size>0.15 0.15 0.6</size></box></geometry>
          <material><ambient>0.1 0.6 0.1 1</ambient><diffuse>0.1 0.6 0.1 1</diffuse></material>
        </visual>
        <collision name="col">
          <pose>0 0 0.3 0 0 0</pose>
          <geometry><box><size>0.15 0.15 0.6</size></box></geometry>
        </collision>
      </link>
    </model>

    <model name="plant_1_2">
      <static>true</static>
      <pose>3.0 0.6 0 0 0 0</pose>
      <link name="link">
        <visual name="stem">
          <pose>0 0 0.3 0 0 0</pose>
          <geometry><box><size>0.15 0.15 0.6</size></box></geometry>
          <material><ambient>0.1 0.6 0.1 1</ambient><diffuse>0.1 0.6 0.1 1</diffuse></material>
        </visual>
        <collision name="col">
          <pose>0 0 0.3 0 0 0</pose>
          <geometry><box><size>0.15 0.15 0.6</size></box></geometry>
        </collision>
      </link>
    </model>

    <model name="plant_1_3">
      <static>true</static>
      <pose>3.0 1.2 0 0 0 0</pose>
      <link name="link">
        <visual name="stem">
          <pose>0 0 0.3 0 0 0</pose>
          <geometry><box><size>0.15 0.15 0.6</size></box></geometry>
          <material><ambient>0.1 0.6 0.1 1</ambient><diffuse>0.1 0.6 0.1 1</diffuse></material>
        </visual>
        <collision name="col">
          <pose>0 0 0.3 0 0 0</pose>
          <geometry><box><size>0.15 0.15 0.6</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- DISEASED plant (yellow) -->
    <model name="plant_1_4_diseased">
      <static>true</static>
      <pose>3.0 1.8 0 0 0 0</pose>
      <link name="link">
        <visual name="stem">
          <pose>0 0 0.3 0 0 0</pose>
          <geometry><box><size>0.15 0.15 0.6</size></box></geometry>
          <material><ambient>0.8 0.7 0.0 1</ambient><diffuse>0.8 0.7 0.0 1</diffuse></material>
        </visual>
        <collision name="col">
          <pose>0 0 0.3 0 0 0</pose>
          <geometry><box><size>0.15 0.15 0.6</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- ===== PLANT ROW 2 (healthy) ===== -->
    <model name="plant_2_1">
      <static>true</static>
      <pose>3.0 -0.6 0 0 0 0</pose>
      <link name="link">
        <visual name="stem">
          <pose>0 0 0.3 0 0 0</pose>
          <geometry><box><size>0.15 0.15 0.6</size></box></geometry>
          <material><ambient>0.1 0.6 0.1 1</ambient><diffuse>0.1 0.6 0.1 1</diffuse></material>
        </visual>
        <collision name="col">
          <pose>0 0 0.3 0 0 0</pose>
          <geometry><box><size>0.15 0.15 0.6</size></box></geometry>
        </collision>
      </link>
    </model>

    <model name="plant_2_2">
      <static>true</static>
      <pose>3.0 -1.2 0 0 0 0</pose>
      <link name="link">
        <visual name="stem">
          <pose>0 0 0.3 0 0 0</pose>
          <geometry><box><size>0.15 0.15 0.6</size></box></geometry>
          <material><ambient>0.1 0.6 0.1 1</ambient><diffuse>0.1 0.6 0.1 1</diffuse></material>
        </visual>
        <collision name="col">
          <pose>0 0 0.3 0 0 0</pose>
          <geometry><box><size>0.15 0.15 0.6</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- DISEASED plant (yellow) -->
    <model name="plant_2_3_diseased">
      <static>true</static>
      <pose>3.0 -1.8 0 0 0 0</pose>
      <link name="link">
        <visual name="stem">
          <pose>0 0 0.3 0 0 0</pose>
          <geometry><box><size>0.15 0.15 0.6</size></box></geometry>
          <material><ambient>0.8 0.7 0.0 1</ambient><diffuse>0.8 0.7 0.0 1</diffuse></material>
        </visual>
        <collision name="col">
          <pose>0 0 0.3 0 0 0</pose>
          <geometry><box><size>0.15 0.15 0.6</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- ===== BOUNDARY WALLS (gives SLAM visual features) ===== -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 6 0.5 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><box><size>12 0.2 1.0</size></box></geometry>
          <material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material>
        </visual>
        <collision name="c">
          <geometry><box><size>12 0.2 1.0</size></box></geometry>
        </collision>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>0 -6 0.5 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><box><size>12 0.2 1.0</size></box></geometry>
          <material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material>
        </visual>
        <collision name="c">
          <geometry><box><size>12 0.2 1.0</size></box></geometry>
        </collision>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>6 0 0.5 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><box><size>0.2 12 1.0</size></box></geometry>
          <material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material>
        </visual>
        <collision name="c">
          <geometry><box><size>0.2 12 1.0</size></box></geometry>
        </collision>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-6 0 0.5 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><box><size>0.2 12 1.0</size></box></geometry>
          <material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material>
        </visual>
        <collision name="c">
          <geometry><box><size>0.2 12 1.0</size></box></geometry>
        </collision>
      </link>
    </model>

  </world>
</sdf>